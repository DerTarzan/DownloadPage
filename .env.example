# PRODUKTIONS-Vorlage. Kopieren nach .env und Werte ersetzen (oder: python scripts/generate_env.py).
# Für lokale Entwicklung über http stattdessen: python scripts/generate_env.py --local  (nutzt .env.local.example)
# .env gehört NICHT ins Git-Repository.

# --- Anwendung ---
ENVIRONMENT=production
# Name der Website (Kopfzeile, Titel, Footer)
APP_NAME=Produktdokumente
# Mindestens 32 Zeichen, zufällig:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Produktion: immer true (Betrieb nur über HTTPS, TLS am Reverse Proxy)
COOKIE_SECURE=true
# /docs, /redoc und /openapi.json: in Produktion aus
DOCS_ENABLED=false
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
MAX_PDF_SIZE_MB=50
MAX_IMAGE_SIZE_MB=5
# Maximale Größe aller übrigen Requests (JSON, Login, ...) in KB; Datei-Uploads begrenzen die beiden Werte oben
MAX_REQUEST_BODY_KB=1024
APP_PORT=8000
# Bind-Adresse des veröffentlichten Ports. 127.0.0.1 = nur der Reverse Proxy auf demselben Host erreicht die App.
# 0.0.0.0 nur setzen, wenn der Port bewusst direkt erreichbar sein soll (z. B. Proxy auf einem anderen Host).
APP_BIND=127.0.0.1
# IP des Reverse Proxys, dessen X-Forwarded-For-Header die App glauben darf (Komma-getrennt). NIEMALS "*".
# Ohne Eintrag gilt der uvicorn-Standard (127.0.0.1,::1): hinter einem Proxy-Container sieht die Login-Bremse dann
# nur die Proxy-IP. Die IP des Proxys im Compose-Netz herausfinden: docker network inspect <projekt>_default
# FORWARDED_ALLOW_IPS=172.18.0.1

# --- Initialer Admin (wird beim ersten Start angelegt, falls noch kein Admin existiert) ---
# Leer lassen = kein automatischer Admin; dann: docker compose exec app python -m app.cli create-admin
# Passwort mindestens 12 Zeichen. Nach dem ersten Start ADMIN_PASSWORD aus der .env entfernen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Datenbank (Docker Compose baut DATABASE_URL daraus selbst zusammen) ---
POSTGRES_DB=docplatform
POSTGRES_USER=docplatform
# Pflichtwert, zufällig wählen. Nur Buchstaben/Ziffern/-/_ verwenden (kommt in eine URL)
POSTGRES_PASSWORD=

# --- Nur für Betrieb OHNE Docker Compose (lokales Python) ---
DATABASE_URL=postgresql+psycopg://docplatform:CHANGE_ME@localhost:5432/docplatform
STORAGE_DIR=storage
