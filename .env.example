# Kopieren nach .env und Werte ersetzen (oder: python scripts/generate_env.py).
# .env gehört NICHT ins Git-Repository.

# --- Anwendung ---
ENVIRONMENT=production
# Name der Website (Kopfzeile, Titel, Footer)
APP_NAME=Produktdokumente
# Mindestens 32 Zeichen, zufällig:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Lokal über http (ohne HTTPS-Proxy) muss das false sein, hinter HTTPS true
COOKIE_SECURE=false
DOCS_ENABLED=true
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
MAX_PDF_SIZE_MB=50
MAX_IMAGE_SIZE_MB=5
APP_PORT=8000

# --- Initialer Admin (wird beim ersten Start angelegt, falls noch kein Admin existiert) ---
# Passwort mindestens 12 Zeichen. Nach dem ersten Start kann ADMIN_PASSWORD aus der .env entfernt werden.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Datenbank (Docker Compose baut DATABASE_URL daraus selbst zusammen) ---
POSTGRES_DB=docplatform
POSTGRES_USER=docplatform
# Nur Buchstaben/Ziffern/-/_ verwenden (kommt in eine URL)
POSTGRES_PASSWORD=docplatform

# --- Nur für Betrieb OHNE Docker Compose (lokales Python) ---
DATABASE_URL=postgresql+psycopg://document:document@localhost:5432/document_platform
STORAGE_DIR=storage
